{
  "manifest_version": 3,
  "name": "Zero Trust - Enterprise Shield",
  "version": "1.0.0",
  "description": "Continuous biometric authentication overlay.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}